# ==========================================
# JARVIS AI Desktop Assistant Configuration
# ==========================================

# Assistant Identity
APP_NAME=JARVIS
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# AI Brain & Reasoning Providers
# Options: gemini | openai | offline
DEFAULT_LLM_PROVIDER=gemini
FALLBACK_TO_OFFLINE=true

# Google Gemini Settings (Get key at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI / Local Model Settings (Ollama / LM Studio / OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Voice Interface & Wake-Word
WAKE_WORD=jarvis
WAKE_WORD_SENSITIVITY=0.5
VOICE_ENGINE=sapi5
VOICE_RATE=185
VOICE_VOLUME=1.0
VOICE_GENDER=male
CONTINUOUS_LISTENING=true

# Windows System Controls & Safety
SAFE_MODE=true
ALLOW_CODE_EXECUTION=true
ALLOW_SYSTEM_POWER_COMMANDS=true
MAX_COMMAND_TIMEOUT_SECONDS=30

# Email Integration (Optional)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Local API & WebSocket Server
API_HOST=127.0.0.1
API_PORT=8765
